{
  "name": "n8n-nodes-clearmakes-agents",
  "version": "0.1.0",
  "description": "Ask your ClearMakes agent questions and search its knowledge from n8n workflows",
  "license": "MIT",
  "homepage": "https://agents.clearmakes.com/docs",
  "keywords": [
    "n8n-community-node-package",
    "clearmakes",
    "ai agent",
    "knowledge base",
    "rag"
  ],
  "author": {
    "name": "ClearMakes",
    "email": "support@clearmakes.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ClearMakes/n8n-nodes-clearmakes-agents.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "test": "node --test test/*.test.js"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/ClearMakesAgentsApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/ClearMakesAgents/ClearMakesAgents.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "release-it": "20.2.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
